with Files("**"):
    BUG_COMPONENT = ("Firefox", "General")

DIRS += ["bundle"]

JAR_MANIFESTS += ["jar.mn"]

MOZ_SRC_FILES += [
    "AdBlocker.sys.mjs",
    "ChromeWebStore.sys.mjs",
    "ClaudeButton.sys.mjs",
    "FreeVPN.sys.mjs",
    "FreeVPNChannelFilter.sys.mjs",
    "FreeVPNTorLauncher.sys.mjs",
    "FreeVPNWidget.sys.mjs",
    "FreeVPNWireGuard.sys.mjs",
]

BROWSER_CHROME_MANIFESTS += ["tests/browser/browser.toml"]

XPCSHELL_TESTS_MANIFESTS += ["tests/xpcshell/xpcshell.toml"]

