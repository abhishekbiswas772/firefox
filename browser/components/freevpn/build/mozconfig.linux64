# Free VPN build for Linux x86_64.
# Artifact builds reuse Mozilla's prebuilt C++/Rust binaries, so only the
# front-end (where Free VPN lives) is built locally. Remove the
# --enable-artifact-builds line for a full build from source.
ac_add_options --enable-application=browser
ac_add_options --enable-artifact-builds
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-freevpn-linux64
